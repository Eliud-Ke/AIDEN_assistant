{
  "productName": "AIDEN Assistant",
  "version": "0.1.6",
  "identifier": "com.aiden.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIDEN",
        "label": "main",
        "width": 470,
        "height": 645,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "shadow": false,
        "alwaysOnTop": true
      },
      {
        "title": "AIDEN Chat",
        "label": "chat_pill",
        "url": "index.html?window=chat_pill",
        "width": 640,
        "height": 130,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../backend/dist/aiden-engine": "aiden-engine"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}